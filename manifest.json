{
  "manifest_version": 3,
  "name": "My Ad Blocker",
  "version": "1.4.0",
  "description": "Blocks ads, dynamically injected advertising, unwanted cross-site popups, redirects, and adds YouTube and Twitch-specific ad protection.",

  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": ["twitch.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": ["twitch-player.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["page-guard.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  }
}
